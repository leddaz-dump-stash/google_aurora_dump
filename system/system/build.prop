# Bluetooth
bluetooth.bta_fts_ops_idle_to_sniff_delay_ms.config=2000
bluetooth.bta_ftc_idle_to_sniff_delay_ms.config=1000
# The Hci command timeout value for BT stack
bluetooth.hci.timeout_milliseconds=5000
####################################
