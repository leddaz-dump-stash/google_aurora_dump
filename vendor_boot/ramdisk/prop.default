# RFCOMM collision timeout
bluetooth.rfcomm.collision_timeout=3
bluetooth.rfcomm.sysproxy.rx.exit_sniff=true
# Bluetooth Page scan Interval time = N * 0.625 ms
# Range: 0x0012 to 0x1000, Default value: 0x400
bluetooth.btm.pagescan_interval=2048
bluetooth.gd.start_timeout=7000
bluetooth.gd.stop_timeout=7500
