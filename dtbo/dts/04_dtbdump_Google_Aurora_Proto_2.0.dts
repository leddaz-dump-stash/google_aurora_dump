	fragment@37 {
		target = <0xffffffff>;

		__overlay__ {

			gpio_keys {
				pinctrl-0 = <0x0a>;

				vol_up {
					status = "disabled";
				};

				vol_down {
					label = "volume_down";
					gpios = <0xffffffff 0x09 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x72>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};
			};
		};
	};

	fragment@38 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,float-option = <0x02>;
		};
	};

	fragment@39 {
		target = <0xffffffff>;

		__overlay__ {

			cs40l26_gpio_pins {

				cs40l26-interrupt {
					phandle = <0x0c>;

					mux {
						pins = "gpio68";
						function = "gpio";
					};

					config {
						pins = "gpio68";
						bias-pull-up;
						input-enable;
					};
				};
			};
		};
	};

	fragment@40 {
		target = <0xffffffff>;

		__overlay__ {

			cs40l26_gpio_pins {

				cs40l26-reset {
					phandle = <0x0b>;

					pinconf {
						pins = "gpio13";
						function = "normal";
						power-source = <0x01>;
						bias-pull-up;
						output-high;
					};
				};
			};
		};
	};

	fragment@41 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";

			cs40l26@43 {
				compatible = "cirrus,cs40l26a";
				reg = <0x43>;
				pinctrl-names = "default";
				pinctrl-0 = <0x0b 0x0c>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x44 0x08>;
				reset-gpios = <0xffffffff 0x0d 0x00>;
				VA-supply = <0xffffffff>;
				cirrus,vibe-state;
				cirrus,vpbr-enable;
				cirrus,vpbr-thld-mv = <0xa20>;
				cirrus,disable-a2h;
				cirrus,disable-dvl;
				phandle = <0x2b>;

				svc-le1 {
					cirrus,min = <0x1f4>;
					cirrus,max = <0x2ee>;
					cirrus,index = <0x01>;
				};

				svc-le2 {
					cirrus,min = <0x3e8>;
					cirrus,max = <0x5dc>;
					cirrus,index = <0x02>;
				};

				svc-le3 {
					cirrus,min = <0x7d0>;
					cirrus,max = <0x960>;
					cirrus,index = <0x03>;
				};
			};
		};
	};

	fragment@42 {
		target = <0xffffffff>;

		__overlay__ {

			cc_pinctrl_sec {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <0x0d 0x0e 0x0f>;
				pinctrl-1 = <0x10 0x11 0x12>;
				qcom,lpi-gpios;
				#gpio-cells = <0x00>;
				phandle = <0x13>;
			};
		};
	};

	fragment@43 {
		target = <0xffffffff>;

		__overlay__ {

			lpi_i2s2_sck {

				lpi_i2s2_sck_sleep {
					phandle = <0x10>;

					mux {
						pins = "gpio10";
						function = "func1";
					};

					config {
						pins = "gpio10";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};

				lpi_i2s2_sck_active {
					phandle = <0x0d>;

					mux {
						pins = "gpio10";
						function = "func1";
					};

					config {
						pins = "gpio10";
						drive-strength = <0x08>;
						bias-disable;
						input-enable;
					};
				};
			};

			lpi_i2s2_ws {

				lpi_i2s2_ws_sleep {
					phandle = <0x11>;

					mux {
						pins = "gpio11";
						function = "func1";
					};

					config {
						pins = "gpio11";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};

				lpi_i2s2_ws_active {
					phandle = <0x0e>;

					mux {
						pins = "gpio11";
						function = "func1";
					};

					config {
						pins = "gpio11";
						drive-strength = <0x08>;
						bias-disable;
						input-enable;
					};
				};
			};

			lpi_i2s2_sd0 {

				lpi_i2s2_sd0_sleep {
					phandle = <0x12>;

					mux {
						pins = "gpio12";
						function = "func2";
					};

					config {
						pins = "gpio12";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};

				lpi_i2s2_sd0_active {
					phandle = <0x0f>;

					mux {
						pins = "gpio12";
						function = "func2";
					};

					config {
						pins = "gpio12";
						drive-strength = <0x08>;
						bias-disable;
						input-enable;
					};
				};
			};
		};
	};

	fragment@44 {
		target = <0xffffffff>;

		__overlay__ {

			cs40l26-codec {
				status = "ok";
				phandle = <0x15>;
			};
		};
