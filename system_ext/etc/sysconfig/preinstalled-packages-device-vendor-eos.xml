<config>
  <!-- Google RIL Service (grilservice) -->
  <install-in-user-type package="com.google.android.grilservice">
      <install-in user-type="SYSTEM" />
  </install-in-user-type>

  <!-- Adaptive Connectivity Services (SCONE) -->
  <install-in-user-type package="com.google.android.apps.scone">
      <install-in user-type="SYSTEM" />
      <install-in user-type="android.os.usertype.profile.MANAGED" />
  </install-in-user-type>
</config>
